<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.StartsWith('Diligencia.UnitTests')) And !$(MSBuildProjectName.StartsWith('Diligencia.IntegrationTests')) And !$(MSBuildProjectName.EndsWith('AppHost'))">
    <InternalsVisibleTo Include="Diligencia.UnitTests" />
    <InternalsVisibleTo Include="Diligencia.IntegrationTests" />
  </ItemGroup>
</Project>
