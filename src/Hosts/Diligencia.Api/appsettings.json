{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Diligencia.Modules.Auditoria": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "O",
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "Identidad": {
    "SessionIdleMinutes": 30,
    "SessionAbsoluteHours": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "ResetTokenMinutes": 60,
    "InvitationTokenHours": 72,
    "AuthRateLimitPerMinute": 10
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "From": "no-reply@diligencia.local"
    }
  },
  "AllowedHosts": "*"
}
